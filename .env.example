# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (formerly Polygon.io) API key for real market data (Stocks Starter plan or above)
# Leave empty to use the built-in market simulator
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional: SQLite file path (default: <project_root>/db/finally.db). Leave commented out
# for Docker: an empty value in --env-file would override the image default /app/db/finally.db
# DB_PATH=
